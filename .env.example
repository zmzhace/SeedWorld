# Baidu Qianfan OpenAI-compatible endpoint (server only)
WORLD_SLICE_API_BASE=https://qianfan.baidubce.com/v2
WORLD_SLICE_API_KEY=replace_me
# This model may use Qianfan's new-user free-token grant; verify eligibility in your console.
WORLD_SLICE_MODEL=ernie-4.5-turbo-128k

# Zep Cloud graph extraction
ZEP_API_KEY=replace_me
SEEDWORLD_ONTOLOGY_MAX_TYPES=10

# Optional. Defaults to ./data
SEEDWORLD_DATA_DIR=./data

# Optional embeddings / vector database
OPENAI_API_KEY=replace_me
QDRANT_URL=http://localhost:6333
