# OpenRouter OpenAI-compatible endpoint (server only)
WORLD_SLICE_API_BASE=https://openrouter.ai/api/v1
WORLD_SLICE_API_KEY=replace_me
# Free 262K-context model used by the staged planning/writing pipeline.
WORLD_SLICE_MODEL=nex-agi/nex-n2.5-mini:free

SEEDWORLD_ONTOLOGY_MAX_TYPES=10

# Optional. Defaults to ./data
SEEDWORLD_DATA_DIR=./data

# Optional embeddings / vector database
OPENAI_API_KEY=replace_me
QDRANT_URL=http://localhost:6333
